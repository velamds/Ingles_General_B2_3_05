tent": "acknowledged and valued. ", "type": "text"}], "selected": 0}, {"correct": 0, "id": 3, "text": "", "_data": [{"content": "trusted.", "type": "text"}], "selected": 0}]}]}, {"id": 3, "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": " What will you do when a customer is upset?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 2", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions:  <span class=\"bullet\">\nRead the clues on the left.</span> <span class=\"bullet\">\nRead the clues on top.</span>  <span class=\"bullet\">\nClick on the correct box in the table to match the clues. </span> <span class=\"bullet\">There is only one answer per question.</span>", "type": "text"}, {"content": "You have 2 attempts to submit your answers. ", "type": "text"}]}], "type": "TAB", "questions": [{"_data": [{"type": "question", "contents": [{"content": "I will do everything in my power ", "type": "text"}]}, {"content": "secondary_2", "type": "objective"}], "type": "text", "id": 0, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "bring you another meal?", "type": "text"}], "selected": 0}, {"correct": 0, "id": 1, "_data": [{"content": "I will leave and never come back.", "type": "text"}], "selected": 0}, {"correct": 1, "id": 2, "_data": [{"content": " to improve the situation.", "type": "text"}], "selected": 0}, {"correct": 0, "id": 3, "_data": [{"content": "speak to the manager.", "type": "text"}], "selected": 0}, {"correct": 0, "id": 4, "_data": [{"